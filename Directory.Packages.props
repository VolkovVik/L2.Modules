    <PackageVersion Include="Microsoft.OpenApi" Version="[2.11.0, 3.0.0)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.9.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="NATS.Extensions.Microsoft.DependencyInjection" Version="3.0.1" />
    <PackageVersion Include="NATS.Net" Version="3.0.1" />
    <PackageVersion Include="NBomber" Version="6.5.0" />
